{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeAll",
    ":automergePr"
  ],
  "ignorePresets": [
    ":ignoreModulesAndTests"
  ],
  "reviewers": [
    "jj"
  ],
  "assignAutomerge": true,
  "packageRules": [
    {
      "groupName": "Spotless",
      "postUpgradeTasks": {
        "commands": [
          "./gradlew spotlessApply"
        ],
        "fileFilters": [
          "**/*"
        ]
      },
      "matchPackageNames": [
        "/^com.diffplug.spotless/"
      ]
    },
    {
      "matchPackageNames": [
        "eclipse-temurin"
      ],
      "allowedVersions": "25-jdk"
    },
    {
      "matchFileNames": [
        "**/src/*/resources/application*.*"
      ],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "**/src/*/resources/application*.*"
      ],
      "matchStrings": [
        "jdbc:tc:postgresql:(?<currentValue>[a-zA-Z0-9.-]+):"
      ],
      "depNameTemplate": "postgres",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "build.gradle.kts"
      ],
      "matchStrings": [
        "(?<depName>gcr\\.io\\/distroless\\/java[0-9]+-debian[0-9]+):(?<currentValue>[^'\"@\\s]+)(?:@(?<currentDigest>sha256:[a-fA-F0-9]+))?"
      ],
      "autoReplaceStringTemplate": "{{{depName}}}:{{#if newValue}}{{{newValue}}}{{else}}{{{currentValue}}}{{/if}}{{#if newDigest}}@{{{newDigest}}}{{/if}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
